# TailorTom VPS / Docker Compose — PRODUCTION-LIKE DEPLOYMENT
# Copy to .env at REPO ROOT (same folder as docker-compose.yml): cp env.vps.example .env
# Compose reads .env from the project root; do not rely on backend/.env for containers.

# -----------------------------------------------------------------------------
# Required for API and worker
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://tailortom:your-secure-postgres-password@postgres:5432/tailortom

# Postgres (must match DATABASE_URL; set a strong POSTGRES_PASSWORD)
POSTGRES_USER=tailortom
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=tailortom

# JWT (required for auth; use a long random string, e.g. openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Queue name (API and worker must match; use "hosted" for production)
# -----------------------------------------------------------------------------
CELERY_QUEUE_NAME=hosted

# -----------------------------------------------------------------------------
# Google OAuth (required for Sign in with Google)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=https://www.tailortom.org

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
# Discord: one alert per failed job/conversion ID (deduped via Redis)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
CELERY_WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=25
COMPILE_TIMEOUT=30
MODEL_NAME=openai/gpt-5-mini
MAX_TOKENS=16000
TEMPERATURE=1.0
