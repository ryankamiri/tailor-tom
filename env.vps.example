# TailorTom VPS / Docker Compose
# Copy to .env at REPO ROOT (same folder as docker-compose.yml): cp env.vps.example .env
# Do not use backend/.env for Docker Compose; Compose reads .env from the project (root) directory.

# Required
OPENAI_API_KEY=your-openai-api-key-here
REDIS_URL=redis://redis:6379/0

# Queue name (API and worker must match; use "hosted" for production VPS)
CELERY_QUEUE_NAME=hosted

# Postgres (required for DB; set a strong POSTGRES_PASSWORD)
POSTGRES_USER=tailortom
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=tailortom
DATABASE_URL=postgresql://tailortom:your-secure-postgres-password@postgres:5432/tailortom

# Optional
CELERY_WORKER_CONCURRENCY=4
COMPILE_TIMEOUT=30
REDIS_TTL_DAYS=7
MODEL_NAME=openai/gpt-5-mini
MAX_TOKENS=16000
TEMPERATURE=1.0
ADMIN_PASSWORD=your-secure-admin-password
