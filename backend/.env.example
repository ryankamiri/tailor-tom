# TailorTom Backend Environment Variables
# Use this for local dev (uvicorn/celery run from backend/). For Docker Compose on a VPS,
# put .env at the repo root and use env.vps.example as a template (REDIS_URL=redis://redis:6379/0, etc.).

# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model Configuration (Optional - defaults shown)
MODEL_NAME=openai/gpt-5-mini
MAX_TOKENS=16000
TEMPERATURE=1.0

# LaTeX Compilation Settings (Optional - defaults shown)
COMPILE_TIMEOUT=30
OPTIMIZER_MAX_WORKERS=2
