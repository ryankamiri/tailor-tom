# TailorTom Backend — LOCAL DEVELOPMENT
# Copy to backend/.env when running uvicorn/celery from the backend directory.
# For Docker Compose on a VPS, use env.vps.example at the REPO ROOT instead.

# -----------------------------------------------------------------------------
# Required for API and worker
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://tailortom:tailortom@127.0.0.1:5432/tailortom
REDIS_URL=redis://127.0.0.1:6379/0
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# JWT (required for auth; use a long random string in production)
# -----------------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-change-in-production

# -----------------------------------------------------------------------------
# Optional — local dev defaults
# -----------------------------------------------------------------------------
CELERY_QUEUE_NAME=local
MODEL_NAME=openai/gpt-5-mini
MAX_TOKENS=16000
TEMPERATURE=1.0
COMPILE_TIMEOUT=30
WORKER_MAX_TASKS_PER_CHILD=25
CELERY_WORKER_CONCURRENCY=4

# Google OAuth (leave empty until you set up a Google Cloud project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# Optional: Discord webhook for Celery task failure notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Optimizer debug (set true in dev for DEBUG lines)
# OPTIMIZER_DEBUG_ENABLED=false
# OPTIMIZER_DEBUG_RAW_TEXT=false
